{
  "name": "patrickadas-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "api:generate": "node ./node_modules/orval/dist/bin/orval.js --config orval.config.ts",
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "test": "node ./node_modules/@playwright/test/cli.js test",
    "api:check": "node scripts/check-contract.cjs",
    "test:unit": "node node_modules/vitest/vitest.mjs run src"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.2",
    "@radix-ui/react-dialog": "1.3.1",
    "@sentry/react": "11.12.0",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.107.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "7.91.0",
    "react-router-dom": "^7.5.0",
    "tailwind-merge": "3.7.0",
    "zod": "3.25.76",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "orval": "7.21.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "typescript": "^5.8.2",
    "vite": "^6.3.4",
    "vitest": "3.2.7"
  }
}
